1. Código JavaScript para adicionar no seu <script>:
JavaScript
function ouvirCampo(fieldId) {
  // Compatibilidade entre navegadores (Chrome, Edge, Safari)
  const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;

  if (!SpeechRecognition) {
    alert("Seu navegador não suporta reconhecimento de voz. Tente usar o Google Chrome.");
    return;
  }

  const recognition = new SpeechRecognition();
  recognition.lang = 'pt-BR'; // Define o idioma para Português do Brasil
  recognition.continuous = false; // Para de escutar assim que detectar uma pausa
  recognition.interimResults = false;

  const campo = document.getElementById(fieldId);
  const labelOriginal = campo.placeholder;

  recognition.onstart = function() {
    campo.placeholder = "Escutando...";
  };

  recognition.onresult = function(event) {
    const textoTranscrito = event.results[0][0].transcript;
    // Preenche o campo e converte para maiúsculo para seguir o padrão do seu script
    campo.value = textoTranscrito.toUpperCase(); 
  };

  recognition.onerror = function(event) {
    console.error("Erro no reconhecimento de voz:", event.error);
  };

  recognition.onend = function() {
    campo.placeholder = labelOriginal;
  };

  recognition.start();
}
