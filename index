          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="22"/></svg>
        </button>
      </div>
    </div>

    <div class="field">
      <label for="f-quantidade">Quantidade e Unidade</label>
      <div class="input-mic-wrapper">
        <input id="f-quantidade" type="text" placeholder="Ex: 5 caixas ou 10 unidades">
        <button type="button" class="btn-mic" onclick="ouvirCampo('f-quantidade')" title="Preencher por voz">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="22"/></svg>
        </button>
      </div>
    </div>

    <div class="field">
      <label for="f-forma">Forma de apresentação</label>
      <div class="input-mic-wrapper">
        <input id="f-forma" type="text" placeholder="Ex: solução ou creme">
        <button type="button" class="btn-mic" onclick="ouvirCampo('f-forma')" title="Preencher por voz">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="22"/></svg>
        </button>
      </div>
    </div>

    <div class="field">
      <label for="f-lote">Nº lote / serial / partnumber</label>
      <div class="input-mic-wrapper">
        <input id="f-lote" type="text" placeholder="Ex: 1254tg">
        <button type="button" class="btn-mic" onclick="ouvirCampo('f-lote')" title="Preencher por voz">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="22"/></svg>
        </button>
      </div>
    </div>

    <div class="field">
      <label for="f-peso">Peso total bruto</label>
      <div class="input-mic-wrapper">
        <input id="f-peso" type="text" placeholder="Ex: 500 g">
        <button type="button" class="btn-mic" onclick="ouvirCampo('f-peso')" title="Preencher por voz">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="22"/></svg>
        </button>
      </div>
    </div>

    <div class="field full">
      <label for="f-data">Prazo de validade</label>
      <div class="input-mic-wrapper">
        <input id="f-data" type="text" placeholder="Ex: 30/06/2026">
        <button type="button" class="btn-mic" onclick="ouvirCampo('f-data')" title="Preencher por voz">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="22"/></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Campo Global -->
  <span class="section-label">Informações Adicionais (Globais)</span>
  <div class="form-grid">
    <div class="field full">
      <label for="f-obs">Informações adicionais sobre a ocorrência: Indicar se foi apresentada prescrição, relatório médico ou outro documento relevante; conservação da embalagem, indícios de fraude, etc.</label>
      <div class="input-mic-wrapper" style="align-items: flex-start;">
        <textarea id="f-obs" placeholder="Informações adicionais..."></textarea>
        <button type="button" class="btn-mic" onclick="ouvirCampo('f-obs')" title="Preencher por voz" style="margin-top: 4px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="22"/></svg>
        </button>
      </div>
    </div>
  </div>

  <button class="btn-extract" onclick="extrair()">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    Gerar texto
  </button>

  <div id="result-area" class="result-area">
    <div class="result-header">
      <span class="result-label">Resultado</span>
      <button class="btn-copy" id="btn-copy" onclick="copiar()">Copiar</button>
    </div>
    <div id="result-text" class="result-text"></div>
  </div>
</div>

<script>
  // Estado da aplicação
  var items = [];
  var currentIndex = 0;
  
  // Campos pertencentes a cada item
  var fields = [
    'nome', 'marca', 'ativo', 'concentracao', 
    'quantidade', 'forma', 'lote', 'peso', 'data'
  ];

  // Inicialização
  window.onload = function() {
    items.push(createEmptyItem());
    renderTabs();
    loadCurrentItem();
  };

  function createEmptyItem() {
    var obj = {};
    fields.forEach(function(f) { obj[f] = ''; });
    return obj;
  }

  function renderTabs() {
    var container = document.getElementById('tabs-container');
    container.innerHTML = '';

    // Botões dos Itens
    items.forEach(function(item, index) {
      var btn = document.createElement('button');
      btn.className = 'tab-btn' + (index === currentIndex ? ' active' : '');
      btn.innerText = 'Item ' + (index + 1);
      btn.onclick = function() { switchItem(index); };
      container.appendChild(btn);
    });

    // Botão + Novo Item
    var addBtn = document.createElement('button');
    addBtn.className = 'tab-btn add-btn';
    addBtn.innerText = '+ Novo Item';
    addBtn.onclick = addNewItem;
    container.appendChild(addBtn);
  }

  function saveCurrentItem() {
    fields.forEach(function(f) {
      items[currentIndex][f] = document.getElementById('f-' + f).value;
    });
  }

  function loadCurrentItem() {
    fields.forEach(function(f) {
      document.getElementById('f-' + f).value = items[currentIndex][f];
    });
  }

  function switchItem(index) {
    saveCurrentItem();
    currentIndex = index;
    loadCurrentItem();
    renderTabs();
  }

  function addNewItem() {
    saveCurrentItem();
    items.push(createEmptyItem());
    currentIndex = items.length - 1; // Seleciona o novo item criado
    loadCurrentItem();
    renderTabs();
  }

  function extrair() {
    // Salva qualquer alteração pendente no item atual
    saveCurrentItem();

    // Arrays para montar texto e HTML
    var itemStrings = items.map(function(item) {
      return fields.map(function(f) { 
        return item[f].trim().toUpperCase(); 
      });
    });

    // Montagem Texto Puro
    var textoItems = itemStrings.map(function(vals) {
      return vals.join('|');
    }).join(';');

    // Montagem HTML (com pipes coloridos)
    var htmlItems = itemStrings.map(function(vals) {
      return vals.map(function(v) {
        return '<span>' + escHtml(v) + '</span>';
      }).join('<span class="pipe">|</span>');
    }).join('<span class="semicolon">;</span><br>');

    // Informações Adicionais (Globais)
    var obs = document.getElementById('f-obs').value.trim().toUpperCase();

    var textoFinal = textoItems;
    var htmlFinal = htmlItems;

    if (obs) {
      textoFinal += '\n\n' + obs;
      htmlFinal += '<br><br><span>' + escHtml(obs).replace(/\n/g, '<br>') + '</span>';
    }

    // Exibição
    document.getElementById('result-text').innerHTML = htmlFinal;
    document.getElementById('result-text').style.textTransform = 'uppercase';
    document.getElementById('result-area').style.display = 'block';
    document.getElementById('btn-copy').textContent = 'Copiar';
    document.getElementById('result-area').scrollIntoView({ behavior: 'smooth', block: 'nearest' });

    // Guarda texto puro para copiar
    document.getElementById('result-area').dataset.raw = textoFinal;
  }

  function escHtml(str) {
    return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function copiar() {
    var texto = document.getElementById('result-area').dataset.raw || '';
    navigator.clipboard.writeText(texto).then(function() {
      var btn = document.getElementById('btn-copy');
      btn.textContent = 'Copiado!';
      setTimeout(function() { btn.textContent = 'Copiar'; }, 1500);
    });
  }

  // ==========================================
  // RECONHECIMENTO DE VOZ (Web Speech API)
  // ==========================================
  var currentRecognition = null;

  function ouvirCampo(fieldId) {
    var SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;

    if (!SpeechRecognition) {
      alert("Seu navegador não suporta reconhecimento de voz. Recomendamos usar o Google Chrome ou Microsoft Edge.");
      return;
    }

    // Se já houver uma escuta ativa, interrompe
    if (currentRecognition) {
      currentRecognition.stop();
    }

    var recognition = new SpeechRecognition();
    currentRecognition = recognition;

    recognition.lang = 'pt-BR';
    recognition.continuous = false;
    recognition.interimResults = false;

    var inputEl = document.getElementById(fieldId);
    var micBtn = inputEl.nextElementSibling;
    var originalPlaceholder = inputEl.placeholder;

    recognition.onstart = function() {
      inputEl.placeholder = "Escutando...";
      if (micBtn) micBtn.classList.add('listening');
    };

    recognition.onresult = function(event) {
      var textoTranscrito = event.results[0][0].transcript;
      
      // Trata vírgulas/pontos e ajusta o texto
      var textoFormatado = textoTranscrito.trim();
      
      // Se for o campo de obs, concatena se já tiver algo; se for outro campo, substitui/preenche
      if (fieldId === 'f-obs' && inputEl.value.trim() !== '') {
        inputEl.value += ' ' + textoFormatado;
      } else {
        inputEl.value = textoFormatado;
      }

      // Atualiza o estado no array JavaScript
      saveCurrentItem();
    };

    recognition.onerror = function(event) {
      console.error("Erro no reconhecimento de voz: ", event.error);
      if (event.error === 'not-allowed') {
        alert("Permissão de microfone negada. Por favor, permita o acesso ao microfone nas configurações do seu navegador.");
      }
    };

    recognition.onend = function() {
      inputEl.placeholder = originalPlaceholder;
      if (micBtn) micBtn.classList.remove('listening');
      currentRecognition = null;
    };

    recognition.start();
  }
</script>
</body>
</html>
